#include <stdio.h>
struct account { int number; float balance; };
void show_value_copy_address(struct account a) {
    printf("Inside pass-by-value copy address: %p\n", (void *)&a);
}
void addInterest(struct account *a, float rate) {
    if (a != NULL) { printf("Inside addInterest address: %p\n", (void *)a); a->balance += a->balance * rate / 100.0f; }
}
int main(void) {
    struct account list[3] = {{101,5000.0f},{102,12000.0f},{103,800.0f}};
    printf("Main first account address: %p\n", (void *)&list[0]);
    show_value_copy_address(list[0]);
    puts("The copy address differs from the original address.");
    for (int i=0; i<3; ++i) addInterest(&list[i], 4.0f);
    puts("\nBalances after 4% interest:");
    for (int i=0; i<3; ++i) printf("%d %.2f\n", list[i].number, list[i].balance);
    printf("First account using pointer: %d %.2f\n", list[0].number, list[0].balance);
    return 0;
}
