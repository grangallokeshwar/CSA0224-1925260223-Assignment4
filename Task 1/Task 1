#include <stdio.h>
#include <string.h>
#define MAX_PATIENTS 100

typedef struct { int systolic, diastolic; } BloodPressure;
typedef struct { int day, month, year; } Date;
typedef struct { char name[50]; int age; char phone[11]; BloodPressure bp; Date visitDate; } Patient;

int addPatient(Patient patients[], int *count, const Patient *newPatient) {
    if (patients == NULL || count == NULL || newPatient == NULL || *count >= MAX_PATIENTS) return 0;
    patients[*count] = *newPatient;
    ++(*count);
    return 1;
}
int main(void) {
    Patient patients[MAX_PATIENTS] = {0};
    int count = 0;
    Patient p = {"Arun", 21, "9876543210", {120, 80}, {23, 11, 2026}};
    if (addPatient(patients, &count, &p)) {
        printf("Patient added successfully\n");
        printf("Name: %s\nAge: %d\nPhone: %s\n", patients[0].name, patients[0].age, patients[0].phone);
        printf("Blood pressure: %d/%d\nVisit date: %02d/%02d/%04d\n", patients[0].bp.systolic, patients[0].bp.diastolic, patients[0].visitDate.day, patients[0].visitDate.month, patients[0].visitDate.year);
        printf("Total patients: %d\n", count);
    } else puts("Could not add patient");
    return 0;
}
